# Copy to .env beside docker-compose.yaml and replace the placeholders.
# DB_PASSWORD must match MYSQL_ROOT_PASSWORD for this local root-user setup.
MYSQL_ROOT_PASSWORD=replace_with_your_local_mysql_password
DB_URL=jdbc:mysql://localhost:3307/poker_java?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=replace_with_your_local_mysql_password
SERVER_PORT=8080
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
POKER_WS_URL=ws://localhost:8080/ws
